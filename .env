# Copy to .env and fill in. All EXPO_PUBLIC_* vars are inlined into the app at
# build time (they are public/publishable keys — safe to ship in the binary).
# Every integration is env-guarded: leave a value empty and that feature simply
# stays off, so the app still boots and runs.

# --- Supabase (NEW tododo project — create one at supabase.com) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google Sign-In (from Google Cloud console OAuth client ids) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- RevenueCat (freemium subscription) ---
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# --- Sentry (crash reporting) ---
EXPO_PUBLIC_SENTRY_DSN=

# --- PostHog (product analytics). Host defaults to US cloud if omitted. ---
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
